# Godot
.godot/
*.import.tmp
export_presets.cfg
/build/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
*.tmp

# GD-Sync API keys. Never commit these.
addons/GD-Sync/keys.cfg

# Agent worktrees (Claude Code); never commit them
.claude/worktrees/

# The user's own hand-made test scene (never commit)
game/world/handmade/world_test_handmade.tscn
game/world/handmade/world_test_handmade_data/

# Godot's temporary copies of loaded GDExtension libraries (recreated by the editor)
addons/**/~*.dll

# Godot import stubs for review captures (generated; the PNGs are kept)
docs/design/zombie_fix/*.import
docs/design/grading/*.import
docs/design/menus_review/*.import

# Python caches (tools/real_island and the Blender helpers)
__pycache__/
